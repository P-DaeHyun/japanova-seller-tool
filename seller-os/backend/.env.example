# JAPANOVA Seller OS backend environment
# 실제 값은 절대 GitHub에 커밋하지 않는다.

PORT=8787
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/japanova

# Shopee Open Platform
SHOPEE_ENV=sandbox
SHOPEE_PARTNER_ID=YOUR_PARTNER_ID
SHOPEE_PARTNER_KEY=YOUR_PARTNER_KEY
SHOPEE_REDIRECT_URI=https://YOUR_BACKEND_DOMAIN/api/shopee/callback

# Token encryption key - 32바이트 이상 강력한 랜덤 문자열
TOKEN_ENCRYPTION_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# CORS - 쉼표로 여러 주소를 허용할 수 있음
ALLOWED_ORIGIN=http://localhost:3000,https://p-daehyun.github.io

# 환율
FX_BUFFER_DEFAULT=0.02
FX_PRIMARY_URL=https://api.frankfurter.dev
FX_FALLBACK_URL=https://open.er-api.com/v6/latest/JPY

# 실제 수익 계산
PAYONEER_RATE=0.02
